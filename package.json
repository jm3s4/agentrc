{
  "name": "@jm3s4/agentrc",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./lib/index.ts",
    "./node": "./lib/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "nodecheck": "bash scripts/check-node-imports.sh",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-snapshots": "vitest run -u",
    "taze": "taze minor -wIr",
    "taze:major": "taze major -wIr",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm nodecheck",
    "check:jsr": "pnpm dlx jsr publish --dry-run --allow-slow-types",
    "version": "node scripts/sync-version.mjs && git add jsr.json",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ipaddr.js": "^2.5.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "taze": "^21.3.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
