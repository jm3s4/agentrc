{
  "name": "@ekisa/agent",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./lib/index.ts",
    "./node": "./lib/node/index.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "nodecheck": "bash scripts/check-node-imports.sh",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test",
    "test:update-snapshots": "bun test --update-snapshots",
    "taze": "taze minor -wIr",
    "taze:major": "taze major -wIr",
    "publish": "",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run nodecheck"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ipaddr.js": "^2.5.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "taze": "^21.3.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
